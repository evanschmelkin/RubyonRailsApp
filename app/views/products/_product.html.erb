<div id="<%= dom_id product %>">
  <p>
    <strong>Name:</strong>
    <%= product.name %>
  </p>

  <p>
    <strong>Price:</strong>
    <%= product.price %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= product.description %>
  </p>

  <p>
    <strong>Count:</strong>
    <%= product.count %>
  </p>

  <p>
    <strong>Is active:</strong>
    <%= product.is_active %>
  </p>

</div>
